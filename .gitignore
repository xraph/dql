# Compiled binaries. Go's cmd/<name>/ convention builds a binary named after
# its directory, so `go build ./...` inside cmd/dql-lsp/ writes it in place.
# Add a line here for each new cmd/ binary.
/cmd/dql-lsp/dql-lsp

# Test binaries and profiles. `go test -cpuprofile` leaves the compiled test
# binary behind in the package directory.
*.test
*.prof

# go.work is committed — the LSP module needs it to build against the library
# beside it. go.work.sum is not: nothing here requires it, and it is local
# resolution state rather than something a checkout depends on.
go.work.sum
